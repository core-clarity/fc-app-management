# Neon（BPRシステムとは別プロジェクトで作成）
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_L6Dz7oMbErNf@ep-plain-sky-axo06rci-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# NextAuth
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- ユーザーパスワード（SEED_PASSWORD_*）---
# ログイン時に使われるのはこの平文ではなく、Neon の users.password_hash。
# 反映手順: ここを編集 → プロジェクト直下で npm run db:seed
# ※ .env.local の DATABASE_URL が指す DB（本番 Neon と同一なら本番も更新される）
# ※ seed は対象ユーザーのハッシュを全件上書きする。全ユーザのパスワード下記の内容で更新される。実行前に意図した値か確認
# ※ Vercel の Environment Variables に SEED_PASSWORD_* は不要（実行時ログインには使わない）
# 変更後: ブラウザの旧セッションが残ることがあるので、必要なら再ログイン
#
# SEED_PASSWORD_KATSURA=
# SEED_PASSWORD_FRIEND_B=
# SEED_PASSWORD_PAST_VIEWER=
# 閲覧専用ログイン ID: past-viewer@fc-app.local（コードの PAST_VIEWER_EMAIL）
# Seed（npm run db:seed）— 本番に出さないローカル用
SEED_PASSWORD_KATSURA=
SEED_PASSWORD_FRIEND_B=
SEED_PASSWORD_PAST_VIEWER=
# 閲覧専用ログイン ID はコード上 past-viewer@fc-app.local（PAST_VIEWER_EMAIL）

# Anthropic（Vision API）
ANTHROPIC_API_KEY=
